NODE_ENV=development
PORT=8000
# Docker Compose database (see docker-compose.yml)
DATABASE_URL=postgresql://ebook:ebook@localhost:5433/ebook
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Signs access tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Login/register attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
# Public URL of this API, used in links to uploaded files
PUBLIC_API_URL=http://localhost:8000
# Where uploaded covers are stored, relative to apps/api
UPLOAD_DIR=uploads
