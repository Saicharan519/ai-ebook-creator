generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]
  books    Book[]
  aiUsage  AiUsage[]

  @@map("users")
}

enum AiKind {
  outline
  draft
  inline
  memory
}

/// One row per AI call, for the daily per-user token quota
model AiUsage {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  kind         AiKind
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage")
}

enum BookStatus {
  draft
  published
}

model Book {
  id           String     @id @default(uuid(7)) @db.Uuid
  ownerId      String     @map("owner_id") @db.Uuid
  title        String
  subtitle     String     @default("")
  author       String
  genre        String     @default("")
  premise      String     @default("")
  writingStyle String     @default("") @map("writing_style")
  /// Storage key of the cover image, e.g. "covers/<uuid>.png"
  coverKey     String?    @map("cover_key")
  status       BookStatus @default(draft)
  /// Public reader address (/read/<slug>); kept after unpublishing so the link stays the same
  slug         String?    @unique
  publishedAt  DateTime?  @map("published_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  owner    User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chapters Chapter[]
  entities           Entity[]
  warnings           ConsistencyWarning[]
  dismissedConflicts DismissedConflict[]

  @@index([ownerId, updatedAt])
  @@map("books")
}

model Chapter {
  id          String   @id @default(uuid(7)) @db.Uuid
  bookId      String   @map("book_id") @db.Uuid
  /// 0-based order within the book; kept contiguous by the service layer
  position    Int
  title       String
  description String   @default("")
  /// Chapter text as Markdown
  content     String   @default("")
  wordCount   Int      @default(0) @map("word_count")
  /// Short AI summary, used as context when writing later chapters
  summary     String   @default("")
  /// Hash of the content Story Memory last processed; null if never processed
  memoryHash  String?  @map("memory_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  book     Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chunks   Chunk[]
  facts    Fact[]
  mentions Mention[]
  versions ChapterVersion[]
  branches ChapterBranch[]

  @@index([bookId, position])
  @@map("chapters")
}

/// One row per refresh token. Tokens are stored hashed and rotated on every
/// refresh; all tokens issued from one login share a familyId so a reused
/// (stolen) token can revoke the whole chain.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// A passage of chapter text with its embedding, for similarity search
model Chunk {
  id        String                     @id @default(uuid(7)) @db.Uuid
  /// Copied from the chapter so a book's chunks can be searched without a join
  bookId    String                     @map("book_id") @db.Uuid
  chapterId String                     @map("chapter_id") @db.Uuid
  position  Int
  text      String
  /// Unit-length Gemini embedding; written and queried with raw SQL (pgvector)
  embedding Unsupported("vector(768)")

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([chapterId])
  @@map("chunks")
}

enum EntityKind {
  character
  place
  item
  group
}

/// Who created a Story Bible entry. The author's entries are never overwritten by extraction.
enum MemorySource {
  ai
  author
}

/// A character, place, item, or group in the Story Bible
model Entity {
  id          String       @id @default(uuid(7)) @db.Uuid
  bookId      String       @map("book_id") @db.Uuid
  kind        EntityKind
  name        String
  aliases     String[]     @default([])
  description String       @default("")
  /// Pinned entries are always included in the AI's context
  pinned      Boolean      @default(false)
  source      MemorySource @default(ai)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  book     Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  facts    Fact[]
  mentions Mention[]

  @@index([bookId])
  @@map("entities")
}

/// A checkable detail about an entity, e.g. ("eye colour", "grey") from chapter 3
model Fact {
  id        String       @id @default(uuid(7)) @db.Uuid
  entityId  String       @map("entity_id") @db.Uuid
  /// The chapter it was extracted from; null for facts the author added
  chapterId String?      @map("chapter_id") @db.Uuid
  attribute String
  value     String
  source    MemorySource @default(ai)
  createdAt DateTime     @default(now()) @map("created_at")

  entity      Entity               @relation(fields: [entityId], references: [id], onDelete: Cascade)
  chapter     Chapter?             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  warnings    ConsistencyWarning[] @relation("WarningFact")
  conflictsOf ConsistencyWarning[] @relation("WarningConflictingFact")

  @@index([entityId, attribute])
  @@index([chapterId])
  @@map("facts")
}

/// An entity appearing in a chapter, with a short quote for context
model Mention {
  entityId  String @map("entity_id") @db.Uuid
  chapterId String @map("chapter_id") @db.Uuid
  excerpt   String @default("")

  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([entityId, chapterId])
  @@index([chapterId])
  @@map("mentions")
}

enum WarningStatus {
  open
  dismissed
}

/// Two facts about the same entity that contradict each other
model ConsistencyWarning {
  id                String        @id @default(uuid(7)) @db.Uuid
  bookId            String        @map("book_id") @db.Uuid
  factId            String        @map("fact_id") @db.Uuid
  conflictingFactId String        @map("conflicting_fact_id") @db.Uuid
  explanation       String
  /// Identifies the conflict itself (entity, detail, both values), so a dismissal
  /// still applies after the chapters are re-read and the facts get new ids
  fingerprint       String
  status            WarningStatus @default(open)
  createdAt         DateTime      @default(now()) @map("created_at")

  book            Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  fact            Fact @relation("WarningFact", fields: [factId], references: [id], onDelete: Cascade)
  conflictingFact Fact @relation("WarningConflictingFact", fields: [conflictingFactId], references: [id], onDelete: Cascade)

  @@unique([factId, conflictingFactId])
  @@index([bookId, status])
  @@map("consistency_warnings")
}

/// An uploaded file (book covers), used when STORAGE_DRIVER=database
model StoredFile {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stored_files")
}

/// A conflict the author said is fine; never raised again for this book
model DismissedConflict {
  bookId      String   @map("book_id") @db.Uuid
  fingerprint String
  createdAt   DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, fingerprint])
  @@map("dismissed_conflicts")
}

/// Why a version snapshot was taken
enum VersionReason {
  /// The author asked for it
  manual
  /// Taken at most every 10 minutes while autosaving
  autosave
  /// The text just before an AI suggestion was accepted
  before_ai
  /// The text just before an older version was restored
  before_restore
  /// The main text just before a what-if branch replaced it
  before_keep
}

/// A saved copy of a chapter's text at one moment. branchId is null for the main text.
model ChapterVersion {
  id        String        @id @default(uuid(7)) @db.Uuid
  chapterId String        @map("chapter_id") @db.Uuid
  branchId  String?       @map("branch_id") @db.Uuid
  reason    VersionReason
  label     String        @default("")
  title     String
  content   String
  wordCount Int           @map("word_count")
  createdAt DateTime      @default(now()) @map("created_at")

  chapter Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  branch  ChapterBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([chapterId, branchId, createdAt])
  @@map("chapter_versions")
}

/// A "what-if" draft of a chapter. It has its own text until the author keeps it
/// (it replaces the main text) or discards it. Story Memory only reads the main text.
model ChapterBranch {
  id        String   @id @default(uuid(7)) @db.Uuid
  chapterId String   @map("chapter_id") @db.Uuid
  name      String
  content   String
  wordCount Int      @map("word_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chapter  Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  versions ChapterVersion[]

  @@unique([chapterId, name])
  @@map("chapter_branches")
}
