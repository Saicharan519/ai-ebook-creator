NODE_ENV=development
PORT=8000
# Docker Compose database (see docker-compose.yml)
DATABASE_URL=postgresql://ebook:ebook@localhost:5433/ebook
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Signs access tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Login/register attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
# Proxies in front of the app (0 locally, 2 on Render behind Vercel's /api proxy)
TRUST_PROXY_HOPS=0
# Refresh cookie settings; production behind the /api proxy uses /api/auth and lax
AUTH_COOKIE_PATH=/auth
AUTH_COOKIE_SAMESITE=lax
# Public URL of this API, used in links to uploaded files
PUBLIC_API_URL=http://localhost:8000
# "disk" (UPLOAD_DIR) or "database" (Postgres; use on hosts whose disk is wiped on restart)
STORAGE_DRIVER=disk
# Where uploaded covers are stored, relative to apps/api
UPLOAD_DIR=uploads
# AI provider: "gemini" (needs GEMINI_API_KEY) or "fake" (placeholder text, no key needed)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tokens one user may spend per day, and AI requests per minute
AI_DAILY_TOKEN_LIMIT=200000
AI_RATE_LIMIT_PER_MINUTE=20
# Every request from one IP address, per minute (login, AI and the public reader have stricter limits)
GLOBAL_RATE_LIMIT_PER_MINUTE=300
# Embedding model for Story Memory search
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Seconds after the last edit before Story Memory re-reads a chapter
MEMORY_DEBOUNCE_SECONDS=30
# Cheaper model for background Story Memory work (its own quota, separate from writing help)
GEMINI_MEMORY_MODEL=gemini-3.5-flash-lite
